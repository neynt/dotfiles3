#!/bin/bash
set -euo pipefail

hostname=$(cat /etc/hostname 2>/dev/null || hostname)
if [[ "$hostname" == "saltblock-arch" ]]; then
  diary_root="/home/neynt/diary"
  is_macos=false
else
  diary_root="/Users/neynt/diary"
  is_macos=true
fi

format_date() {
  local timestamp=$1
  if [[ "$is_macos" == "true" ]]; then
    date -r "$timestamp" "+%Y-%m-%d"
  else
    date -d "@$timestamp" "+%Y-%m-%d"
  fi
}

dow_for_date() {
  local date_str=$1
  if [[ "$is_macos" == "true" ]]; then
    date -j -f "%Y-%m-%d" "$date_str" "+%a"
  else
    date -d "$date_str" "+%a"
  fi
}

parse_date() {
  local input=$1
  case "$input" in
    yesterday)
      if [[ "$is_macos" == "true" ]]; then
        date -v-1d "+%s"
      else
        date -d "yesterday" "+%s"
      fi
      ;;
    tomorrow)
      if [[ "$is_macos" == "true" ]]; then
        date -v+1d "+%s"
      else
        date -d "tomorrow" "+%s"
      fi
      ;;
    today)
      date "+%s"
      ;;
    *[0-9]*-*[0-9]*-*[0-9]*)
      if [[ "$is_macos" == "true" ]]; then
        date -j -f "%Y-%m-%d" "$input" "+%s"
      else
        date -d "$input" "+%s"
      fi
      ;;
    *)
      echo "Error: Invalid date format. Use 'yesterday', 'today', 'tomorrow', or YYYY-MM-DD" >&2
      exit 1
      ;;
  esac
}

# Extract a single day's content from a monthly file (without the ## header)
extract_day() {
  local month_file=$1
  local date_str=$2
  [[ -f "$month_file" ]] || return
  sed -n "/^## $date_str\( \|$\)/,/^## /{/^## $date_str\( \|$\)/d;/^## /d;p}" "$month_file"
}

specified_date=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -d|--date)
      specified_date="$2"
      shift 2
      ;;
    *)
      echo "Unknown option: $1"
      echo "Usage: $0 [-d|--date YYYY-MM-DD|yesterday|today|tomorrow]"
      exit 1
      ;;
  esac
done

if [[ ! -d "$diary_root" ]]; then
  echo "Diary directory does not exist: $diary_root"
  exit 1
fi

cd "$diary_root"

if [[ -n "$specified_date" ]]; then
  now=$(parse_date "$specified_date")
else
  now=$(date "+%s")
fi

yyyymmdd=$(format_date $((now - 3600 * 4)))
yyyy="${yyyymmdd%%-*}"
mm="${yyyymmdd:5:2}"
dd="${yyyymmdd:8:2}"

month_file="$yyyy-$mm.md"

# Add today's header if it doesn't already exist in the monthly file
if ! grep -qE "^## $yyyymmdd( |$)" "$month_file" 2>/dev/null; then
  # Add blank line before header if file already has content
  if [[ -f "$month_file" ]] && [[ -s "$month_file" ]]; then
    echo "" >> "$month_file"
  fi
  echo "## $yyyymmdd ($(dow_for_date "$yyyymmdd"))" >> "$month_file"
  echo "" >> "$month_file"
fi

$EDITOR '+normal G' "$month_file"

blue="\033[1;34m"
green="\033[1;32m"
nocolor="\033[0m"
(
  cat prompt.md;
  for days_ago in 365 90 30 7 2 1 0; do
    past_date=$(format_date $((now - 3600 * 4 - 86400 * days_ago)))
    past_month_file="${past_date:0:7}.md"
    day_content=$(extract_day "$past_month_file" "$past_date")
    if [[ -n "$day_content" ]]; then
      word_count=$(echo "$day_content" | wc -w)
      echo
      printf "${green}## $past_date ($days_ago days ago, %d words)${nocolor}\n" "$word_count"
      echo
      echo "$day_content"
      echo
    fi
  done
) | less -r

today_content=$(extract_day "$month_file" "$yyyymmdd")
if [[ -n "$today_content" ]]; then
  word_count=$(echo "$today_content" | wc -w)
  echo
  printf "${blue}You wrote %d words today.${nocolor}\n" "$word_count"
fi
